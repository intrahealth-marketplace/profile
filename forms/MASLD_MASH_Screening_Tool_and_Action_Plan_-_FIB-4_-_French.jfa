it or Combo, Checked for ' +\0d\0a      'CheckBox, Caption for Label etc.'#13#10#39'   Profile.Variable("Controls' +\0d\0a      '").Value.ItemByName("edtAltContactName").MainValue = "SampleValu' +\0d\0a      'e"'#13#10\0d\0a    \0d\0a      'Calculate FIB-4=Sub Main ( )^^^'#9'Dim aAgeRaw, aAge, aAST, aALT, a' +\0d\0a      'Plt, aScore, aRisk, aPlan, aAgeText, aPos, aChar^^^'#9'aAgeRaw = Fo' +\0d\0a      'rm.Controls_("edtPatientAge").AsVariant^^^'#9'aAgeText = Trim(CStr(' +\0d\0a      'aAgeRaw))^^^'#9'aPos = 1^^^'#9'Do While aPos <= Len(aAgeText)^^^'#9#9'aCha' +\0d\0a      'r = Mid(aAgeText, aPos, 1)^^^'#9#9'If aChar < "0" Or aChar > "9" The' +\0d\0a      'n^^^'#9#9#9'Exit Do^^^'#9#9'End If^^^'#9#9'aPos = aPos + 1^^^'#9'Loop^^^'#9'If aPos' +\0d\0a      ' > 1 Then^^^'#9#9'aAgeText = Left(aAgeText, aPos - 1)^^^'#9'End If^^^'#9'I' +\0d\0a      'f Not IsNumeric(aAgeText) Then^^^'#9#9'Profile.MessageBox "Impossibl' +\0d\0a      'e de lire l'#8217#226'ge du patient. Veuillez confirmer les donn'#233'es d'#233'mog' +\0d\0a      'raphiques avant de calculer."^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aAge = C' +\0d\0a      'Dbl(aAgeText)^^^'#9'aAST = Form.Controls_("edtASTValue").AsVariant^' +\0d\0a      '^^'#9'If Not IsNumeric(aAST) Then^^^'#9#9'Profile.MessageBox "Veuillez ' +\0d\0a      'entrer une valeur valide pour l'#8217'AST (U/L)."^^^'#9#9'Form.Controls_("' +\0d\0a      'edtASTValue").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'If CDbl(aAST) <' +\0d\0a      '= 0 Then^^^'#9#9'Profile.MessageBox "Veuillez entrer une valeur vali' +\0d\0a      'de pour l'#8217'AST (U/L)."^^^'#9#9'Form.Controls_("edtASTValue").SetFocus' +\0d\0a      '^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aALT = Form.Controls_("edtALTValue").' +\0d\0a      'AsVariant^^^'#9'If Not IsNumeric(aALT) Then^^^'#9#9'Profile.MessageBox ' +\0d\0a      '"Veuillez entrer une valeur valide pour l'#8217'ALT (U/L)."^^^'#9#9'Form.C' +\0d\0a      'ontrols_("edtALTValue").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'If CD' +\0d\0a      'bl(aALT) <= 0 Then^^^'#9#9'Profile.MessageBox "Veuillez entrer une v' +\0d\0a      'aleur valide pour l'#8217'ALT (U/L)."^^^'#9#9'Form.Controls_("edtALTValue"' +\0d\0a      ').SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aPlt = Form.Controls_("edtP' +\0d\0a      'lateletValue").AsVariant^^^'#9'If Not IsNumeric(aPlt) Then^^^'#9#9'Prof' +\0d\0a      'ile.MessageBox "Veuillez entrer une num'#233'ration plaquettaire vali' +\0d\0a      'de (10^9/L)."^^^'#9#9'Form.Controls_("edtPlateletValue").SetFocus^^^' +\0d\0a      #9#9'Exit Sub^^^'#9'End If^^^'#9'If CDbl(aPlt) <= 0 Then^^^'#9#9'Profile.Mess' +\0d\0a      'ageBox "Veuillez entrer une num'#233'ration plaquettaire valide (10^9' +\0d\0a      '/L)."^^^'#9#9'Form.Controls_("edtPlateletValue").SetFocus^^^'#9#9'Exit S' +\0d\0a      'ub^^^'#9'End If^^^'#9'aScore = (aAge * CDbl(aAST)) / (CDbl(aPlt) * Sqr' +\0d\0a      '(CDbl(aALT)))^^^'#9'aScore = Round(aScore, 2)^^^'#9'Form.Controls_("ed' +\0d\0a      'tFIB4Score").Text = aScore^^^'#9'If aScore > 2.67 Then^^^'#9#9'aRisk = ' +\0d\0a      '"'#201'lev'#233'"^^^'#9#9'aPlan = "Orienter vers un gastroent'#233'rologue ou un h'#233 +\0d\0a      'patologue."^^^'#9'ElseIf aScore >= 1.30 Then^^^'#9#9'aRisk = "Interm'#233'di' +\0d\0a      'aire"^^^'#9#9'aPlan = "Effectuer une mesure de la rigidit'#233' du foie (' +\0d\0a      'VCTE/ELF ou autre test). Si non disponible, envisager une orient' +\0d\0a      'ation directe vers un gastroent'#233'rologue ou un h'#233'patologue."^^^'#9'E' +\0d\0a      'lse^^^'#9#9'aRisk = "Faible"^^^'#9#9'aPlan = "Prise en charge de la MASL' +\0d\0a      'D en soins primaires/endocrinologie. R'#233#233'valuer le FIB-4 tous les' +\0d\0a      ' 1 '#224' 2 ans."^^^'#9'End If^^^'#9'Form.Controls_("edtRiskLevel").Text = ' +\0d\0a      'aRisk^^^'#9'Form.Controls_("memActionPlan").Text = aPlan^^^End Sub'\0d\0a    'Form Save=Sub Main ( )^^^'#9'Form.Save^^^'#9'Form.Close^^^End Sub'\0d\0a    'Form Print=Sub Main ( )^^^'#9'Form.Print^^^End Sub')\0d\0a  PixelsPerIn
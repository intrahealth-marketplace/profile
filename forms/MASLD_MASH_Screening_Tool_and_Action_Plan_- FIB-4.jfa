d for ' +\0d\0a      'CheckBox, Caption for Label etc.'#13#10#39'   Profile.Variable("Controls' +\0d\0a      '").Value.ItemByName("edtAltContactName").MainValue = "SampleValu' +\0d\0a      'e"'#13#10\0d\0a    \0d\0a      'Calculate FIB-4=Sub Main ( )^^^'#9'Dim aAgeRaw, aAge, aAST, aALT, a' +\0d\0a      'Plt, aScore, aRisk, aPlan, aAgeText^^^'#9'aAgeRaw = Form.Controls_(' +\0d\0a      '"edtPatientAge").AsVariant^^^'#9'aAgeText = Trim(CStr(aAgeRaw))^^^'#9 +\0d\0a      'If InStr(aAgeText, "y") > 0 Then^^^'#9#9'aAgeText = Trim(Left(aAgeTe' +\0d\0a      'xt, InStr(aAgeText, "y") - 1))^^^'#9'ElseIf InStr(aAgeText, "Y") > ' +\0d\0a      '0 Then^^^'#9#9'aAgeText = Trim(Left(aAgeText, InStr(aAgeText, "Y") -' +\0d\0a      ' 1))^^^'#9'End If^^^'#9'If Not IsNumeric(aAgeText) Then^^^'#9#9'Profile.Me' +\0d\0a      'ssageBox "Patient age could not be read. Please confirm patient ' +\0d\0a      'demographics before calculating."^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aAge' +\0d\0a      ' = CDbl(aAgeText)^^^'#9'aAST = Form.Controls_("edtASTValue").AsVari' +\0d\0a      'ant^^^'#9'If Not IsNumeric(aAST) Then^^^'#9#9'Profile.MessageBox "Pleas' +\0d\0a      'e enter a valid AST (U/L) value."^^^'#9#9'Form.Controls_("edtASTValu' +\0d\0a      'e").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'If CDbl(aAST) <= 0 Then^^' +\0d\0a      '^'#9#9'Profile.MessageBox "Please enter a valid AST (U/L) value."^^^' +\0d\0a      #9#9'Form.Controls_("edtASTValue").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^' +\0d\0a      '^^'#9'aALT = Form.Controls_("edtALTValue").AsVariant^^^'#9'If Not IsNu' +\0d\0a      'meric(aALT) Then^^^'#9#9'Profile.MessageBox "Please enter a valid AL' +\0d\0a      'T (U/L) value."^^^'#9#9'Form.Controls_("edtALTValue").SetFocus^^^'#9#9'E' +\0d\0a      'xit Sub^^^'#9'End If^^^'#9'If CDbl(aALT) <= 0 Then^^^'#9#9'Profile.Message' +\0d\0a      'Box "Please enter a valid ALT (U/L) value."^^^'#9#9'Form.Controls_("' +\0d\0a      'edtALTValue").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aPlt = Form.Con' +\0d\0a      'trols_("edtPlateletValue").AsVariant^^^'#9'If Not IsNumeric(aPlt) T' +\0d\0a      'hen^^^'#9#9'Profile.MessageBox "Please enter a valid Platelet count ' +\0d\0a      '(10^9/L)."^^^'#9#9'Form.Controls_("edtPlateletValue").SetFocus^^^'#9#9'E' +\0d\0a      'xit Sub^^^'#9'End If^^^'#9'If CDbl(aPlt) <= 0 Then^^^'#9#9'Profile.Message' +\0d\0a      'Box "Please enter a valid Platelet count (10^9/L)."^^^'#9#9'Form.Con' +\0d\0a      'trols_("edtPlateletValue").SetFocus^^^'#9#9'Exit Sub^^^'#9'End If^^^'#9'aS' +\0d\0a      'core = (aAge * CDbl(aAST)) / (CDbl(aPlt) * Sqr(CDbl(aALT)))^^^'#9'a' +\0d\0a      'Score = Round(aScore, 2)^^^'#9'Form.Controls_("edtFIB4Score").Text ' +\0d\0a      '= aScore^^^'#9'If aScore > 2.67 Then^^^'#9#9'aRisk = "High"^^^'#9#9'aPlan =' +\0d\0a      ' "Refer to gastroenterologist or hepatologist."^^^'#9'ElseIf aScore' +\0d\0a      ' >= 1.30 Then^^^'#9#9'aRisk = "Intermediate"^^^'#9#9'aPlan = "Conduct li' +\0d\0a      'ver stiffness measurement (VCTE/ELF or alternative). If unavaila' +\0d\0a      'ble, consider direct referral to gastroenterologist or hepatolog' +\0d\0a      'ist."^^^'#9'Else^^^'#9#9'aRisk = "Low"^^^'#9#9'aPlan = "Manage MASLD in pri' +\0d\0a      'mary care/endocrinology. Reassess FIB-4 every 1-2 years."^^^'#9'End' +\0d\0a      ' If^^^'#9'Form.Controls_("edtRiskLevel").Text = aRisk^^^'#9'Form.Contr' +\0d\0a      'ols_("memActionPlan").Text = aPlan^^^End Sub'\0d\0a    'Form Save=Sub Main ( )^^^'#9'Form.Save^^^'#9'Form.Close^^^End Sub'\0d\0a    'Form Print=Sub Main ( )^^^'#9'Form.Print^^^End Sub')\0d\0a  PixelsPerInch = 96\0d\0a  TextHeight = 13\0d\0a  object aNoteBook: TICDONoteBook\0d\0a    Left = 0\0d\0a    Top = -405\0d\0a    Width = 1275\0d\0a    Height = 1875\0d\0a    Color = clGray\0d\0a    ParentColor = False\0d\0a    TabOrder = 0\0d\0a    OnPageChanged = aNoteBookPageChanged\0d\0a    object TPage\0d\0a      Left = 0\0d\0a      Top = 0\0d\0a      Caption = 'FIB-4 Calculator'\0d\0a      object Page_1: TICDOP